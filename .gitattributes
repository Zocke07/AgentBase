# Normalize all text files to LF in the repository.
# Windows is the primary target (BUILD_SPEC §1 constraint 7) but Linux CI is
# case- and line-ending-sensitive; LF everywhere keeps diffs and CI honest.
* text=auto eol=lf

# Explicitly text, regardless of heuristics.
*.py      text eol=lf
*.pyi     text eol=lf
*.ts      text eol=lf
*.tsx     text eol=lf
*.js      text eol=lf
*.jsx     text eol=lf
*.mjs     text eol=lf
*.cjs     text eol=lf
*.json    text eol=lf
*.jsonc   text eol=lf
*.toml    text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.md      text eol=lf
*.sql     text eol=lf
*.rs      text eol=lf
*.html    text eol=lf
*.css     text eol=lf
justfile  text eol=lf
.nvmrc    text eol=lf
.python-version text eol=lf

# Binary - never touch these.
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.icns    binary
*.webp    binary
*.woff    binary
*.woff2   binary
*.exe     binary
*.dll     binary
*.dylib   binary
*.so      binary
*.db      binary
*.sqlite  binary
*.sqlite3 binary

# Generated / vendored - collapse in diffs and exclude from language stats.
apps/desktop/package-lock.json  linguist-generated=true -diff
apps/backend/uv.lock            linguist-generated=true -diff
packages/schemas/**             linguist-generated=true
